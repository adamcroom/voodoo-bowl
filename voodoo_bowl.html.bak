<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Voodoo Bowl</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #000; display: flex; flex-direction: column; align-items: center; font-family: monospace; }
  #bg-strip { display: block; image-rendering: pixelated; }
  #canvas { display: block; image-rendering: pixelated; cursor: default; }
  #hud { display: flex; justify-content: space-between; width: 568px; padding: 4px 8px; background: #111; color: #aaa; font-size: 12px; }
  #hud b { color: #fff; }
  #msg { width: 568px; text-align: center; background: #0a0a0a; color: #8f8; font-size: 13px; padding: 3px; min-height: 22px; }
  #btns { display: flex; gap: 6px; justify-content: center; padding: 6px; background: #000; }
  #btns button { background: #222; color: #ccc; border: 1px solid #444; padding: 6px 14px; font-size: 16px; cursor: pointer; border-radius: 4px; }
  #btns button:active { background: #444; }
</style>
</head>
<body>
<img id="bg-strip" width="568" height="51">
<canvas id="canvas" width="568" height="280" tabindex="0"></canvas>
<div id="hud">
  <span>Score: <b id="sc">0</b></span>
  <span>Down: <b id="dn">1st</b> &amp; <b id="ytg">10</b></span>
  <span>Time: <b id="tm">60</b>s</span>
</div>
<div id="msg">Press arrow keys or tap buttons to move. Reach the end zone!</div>
<div id="btns">
  <button onclick="tryMove(-1,0)">&#9664;</button>
  <button onclick="tryMove(0,-1)">&#9650;</button>
  <button onclick="tryMove(0,1)">&#9660;</button>
  <button onclick="tryMove(1,0)">&#9654;</button>
</div>

<script>
const SPRITES_B64 = {
  "bg": "data:image/png;base64,",
  "endzone_L": "data:image/png;base64,",
  "endzone_R": "data:image/png;base64,",
  "yard_line": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAMAAAEYCAYAAACZTkxTAAAAbElEQVR4nO3Tuw2AMAwEUMMeWeCmYYqM7AUyCJSB4iiQHRLp0j0phT/nrVYz4Djdm+12ezFwbx1AeX4DSkdSBbF474djvU4T8XWIHBrvGMRvjkM7XR4j48KhIAkcc2SUQ+kVfsHsh8Ghk0nHBYoiMS4ZrPKlAAAAAElFTkSuQmCC",
  "qb0": "data:image/png;base64,",
  "qb1": "data:image/png;base64,",
  "qb2": "data:image/png;base64,",
  "qb3": "data:image/png;base64,",
  "qb4": "data:image/png;base64,",
  "qb_still": "data:image/png;base64,",
  "def0": "data:image/png;base64,",
  "def1": "data:image/png;base64,",
  "def2": "data:image/png;base64,",
  "def3": "data:image/png;base64,",
  "def4": "data:image/png;base64,",
  "ref1": "data:image/png;base64,",
  "ref2": "data:image/png;base64,",
  "tomb1": "data:image/png;base64,",
  "tomb2": "data:image/png;base64,",
  "sack_w": "data:image/png;base64,",
  "sack_e": "data:image/png;base64,",
  "sack_n": "data:image/png;base64,",
  "coffin1": "data:image/png;base64,",
  "coffin2": "data:image/png;base64,",
  "explode1": "data:image/png;base64,",
  "explode2": "data:image/png;base64,",
  "qb_big1": "data:image/png;base64,",
  "qb_big2": "data:image/png;base64,",
  "touchdown": "data:image/png;base64,",
  "click": "data:image/png;base64,",
  "ball": "data:image/png;base64,",
  "eye": "data:image/png;base64,",
  "n0": "data:image/png;base64,",
  "n1": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAA4AAAAUCAYAAAC9BQwsAAAAT0lEQVR4nGNkYGD4z0AGYCJHE06NxmkMDMZnIDTRGo3TGBgY0hgYjEm18ewsBoazJgR0YdNILBjVOFw1GkPSKQMDNM3iSK+MDIMiWw1OjQA2zApUmlq0pQAAAABJRU5ErkJggg==",
  "n2": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAA4AAAAUCAYAAAC9BQwsAAAAnElEQVR4nO2S0Q3DIAxEX6r8dprrTHSBLENmCgt0GfcDlITgpBXfOckS2By+MwyA0YFHDwlgdLMChbxMM5DaIwMHqYqZSAKpkN+QHLKtIUxxtwcLC6alzgFWe0z5dkd5g7+G48m8JpZWn+nplhv97P0Fv9ZMdW0Wi0zH82lHyZ/kIVpScEiKtexKquL26B7m17Y+9fgL3Z/8Jl7gC/bmV5o6KLB9AAAAAElFTkSuQmCC",
  "n3": "data:image/png;base64,",
  "n4": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAA4AAAAUCAYAAAC9BQwsAAAAlUlEQVR4nN2SyxHCMAwFN9zdBg28CmjGqclugDJowKrGBZhDwiE4MpBTBs1ofHha/awJaBywy6cAxcX3rLkuWiyu7oOx0KR9bfJmVFpem/0xumx6tThotVtOCAEluN8Ckl+tA6+PimWotfrUO6gIGFgeMgBslqMCg+6wvE3qfofiD8v51k4EKgHrcav0untyhyv+EfgELS1YPJ7ClAwAAAAASUVORK5CYII=",
  "n5": "data:image/png;base64,",
  "n6": "data:image/png;base64,",
  "n7": "data:image/png;base64,",
  "n8": "data:image/png;base64,",
  "n9": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAA4AAAAUCAYAAAC9BQwsAAAApUlEQVR4nL2TSw7DMAhEJ1W3nGbuRM6UnsmciS7yUWywo3pRJBYeeOIjvABwTNhrBgKAdy9ABUAABtgnz/HKCdcCJ+Ei4ixwlibnGK8StMC5JZrWWj6jJZrWzxzUKLF5B9BsT2IDt01EcD22SIDbgETcVuXUfTmt/ngA1L391obgOaeteTxv8XYInZwoikh6CEPwWka/UgSpj1UuX076V5v+j/8HvxpNhSeMLW9QAAAAAElFTkSuQmCC",
  "d0": "data:image/png;base64,",
  "d1": "data:image/png;base64,",
  "d2": "data:image/png;base64,",
  "d3": "data:image/png;base64,",
};


// Load all images
const IMG = {};
let loaded = 0;
const keys = Object.keys(SPRITES_B64);
keys.forEach(k => {
  const im = new Image();
  im.onload = () => { loaded++; if (loaded === keys.length) initGame(); };
  im.src = SPRITES_B64[k];
  IMG[k] = im;
});

// Display bg strip
document.getElementById('bg-strip').src = SPRITES_B64.bg;

const C = document.getElementById('canvas');
const ctx = C.getContext('2d');
ctx.imageSmoothingEnabled = false;

// Game constants
const CELL = 40, VCELLS = 7, HCELLS = 40, VIEWW = 14;
const W = VIEWW * CELL; // 560
const H = VCELLS * CELL; // 280

// Sprite constants matching bytecode
// Cell types: 0=empty, 6-7=referee, 8-12=zombie defenders, 13-14=tombstone, 15-18=sack direction
const ZOMBIE = [10,11];
const TOMB = [13,14];
const REF = [6,7];
const SACK = [15,16,17,18]; // N,S,W,E equivalent

let G = {}; // game state

function newGame() {
  G = {
    qbX: 0, qbY: Math.floor(VCELLS/2),
    viewX: 0,
    field: Array.from({length:HCELLS}, ()=>Array(VCELLS).fill(0)),
    grass: Array.from({length:HCELLS}, ()=>Array(VCELLS).fill(0)),
    score: 0, down: 1, toFirst: 10, scrimage: 0,
    usedTime: 0, startTime: 0,
    gameOver: false, sacked: false, touchdown: false,
    pauseTime: 0, density: 0.15,
    tick: 0, qbFrame: 1, qbDepth: 0,
  };
  placeGrass();
  placeDefenders();
  updateHUD();
  draw();
  setMsg("Reach the end zone! Arrow keys or buttons.");
}

function placeGrass() {
  let count = Math.floor(HCELLS * VCELLS * 0.1);
  for (let i = 0; i < count; i++) {
    let x = 1 + rnd(HCELLS - 2);
    let y = rnd(VCELLS);
    G.grass[x][y] = 1 + rnd(3); // grass types 1,2,3 -> images[8-10] region
  }
}

function placeDefenders() {
  let count = Math.floor(HCELLS * VCELLS * 0.02);
  for (let i = 0; i < count; i++) {
    let x = 1 + rnd(HCELLS - 2);
    let y = rnd(VCELLS);
    if (G.field[x][y] === 0) G.field[x][y] = 8 + rnd(5); // 8-12
  }
}

function spawnMore() {
  let remaining = HCELLS - G.qbX - 1;
  if (remaining <= 0) return;
  let count = Math.floor(remaining * VCELLS * G.density);
  for (let i = 0; i < count; i++) {
    let x = G.qbX + 1 + rnd(remaining);
    let y = rnd(VCELLS);
    if (x > 0 && x < HCELLS-1 && G.field[x][y] === 0)
      G.field[x][y] = 8 + rnd(5);
  }
}

function rnd(n) { return Math.floor(Math.random() * n); }

// ---- Drawing ----

function drawField() {
  // Green background
  ctx.fillStyle = '#2d7a1a';
  ctx.fillRect(0, 0, W, H);

  // Left endzone
  if (G.viewX === 0) {
    ctx.drawImage(IMG.endzone_L, 0, 0);
  }
  // Right endzone
  let ezVX = (HCELLS - 1) - G.viewX;
  if (ezVX >= 0 && ezVX < VIEWW) {
    ctx.drawImage(IMG.endzone_R, ezVX * CELL, 0);
  }

  // Yard lines every 10 cells
  for (let fx = 0; fx < HCELLS; fx += 10) {
    let vx = fx - G.viewX;
    if (vx >= 0 && vx < VIEWW) {
      for (let y = 0; y < H; y += 3) {
        ctx.drawImage(IMG.yard_line, vx * CELL, y);
      }
    }
  }

  // Scrimmage line (yellow dashed)
  let scrimVX = G.scrimage - G.viewX;
  if (scrimVX >= 0 && scrimVX < VIEWW) {
    ctx.strokeStyle = 'rgba(255,220,0,0.7)';
    ctx.lineWidth = 2;
    ctx.setLineDash([5,4]);
    ctx.beginPath();
    ctx.moveTo(scrimVX * CELL, 0);
    ctx.lineTo(scrimVX * CELL, H);
    ctx.stroke();
    ctx.setLineDash([]);
  }

  // First down line (blue dashed)
  let fdVX = (G.scrimage + G.toFirst) - G.viewX;
  if (fdVX >= 0 && fdVX < VIEWW) {
    ctx.strokeStyle = 'rgba(0,180,255,0.6)';
    ctx.lineWidth = 2;
    ctx.setLineDash([4,4]);
    ctx.beginPath();
    ctx.moveTo(fdVX * CELL, 0);
    ctx.lineTo(fdVX * CELL, H);
    ctx.stroke();
    ctx.setLineDash([]);
  }
}

function drawSprites() {
  for (let vx = 0; vx < VIEWW; vx++) {
    let fx = vx + G.viewX;
    if (fx >= HCELLS) continue;
    for (let vy = 0; vy < VCELLS; vy++) {
      let px = vx * CELL, py = vy * CELL;
      // Grass decoration
      let g = G.grass[fx][vy];
      if (g > 0) {
        // Use defender sprites 0-4 as grass variants (they happen to be grassy looking)
        // Actually just draw a subtle tint
        ctx.fillStyle = 'rgba(0,80,0,0.15)';
        ctx.fillRect(px+4, py+4, 32, 32);
      }
      // Field objects
      let c = G.field[fx][vy];
      if (c >= 8 && c <= 12) {
        // Zombie defender
        ctx.drawImage(IMG['def' + (c-8)], px, py, CELL, CELL);
      } else if (c === 13) {
        ctx.drawImage(IMG.tomb1, px, py, CELL, CELL);
      } else if (c === 14) {
        ctx.drawImage(IMG.tomb2, px, py, CELL, CELL);
      } else if (c === 6) {
        ctx.drawImage(IMG.ref1, px, py, CELL, CELL);
      } else if (c === 7) {
        ctx.drawImage(IMG.ref2, px, py, CELL, CELL);
      } else if (c >= 15 && c <= 18) {
        // Sack animation - show explosion
        if (G.tick % 2 === 0)
          ctx.drawImage(IMG.explode1, px, py, CELL, CELL);
        else
          ctx.drawImage(IMG.explode2, px, py, CELL, CELL);
      }
    }
  }
}

function drawQB() {
  let vx = G.qbX - G.viewX;
  if (vx < 0 || vx >= VIEWW) return;
  let px = vx * CELL, py = G.qbY * CELL;
  if (G.sacked) {
    ctx.drawImage(IMG.explode1, px, py, CELL, CELL);
  } else {
    let frame = (G.qbFrame || 0) % 5;
    ctx.drawImage(IMG['qb'+frame], px, py, CELL, CELL);
    if (G.qbDepth > 0) {
      ctx.fillStyle = 'rgba(255,200,0,0.3)';
      ctx.beginPath();
      ctx.arc(px+20, py+20, G.qbDepth/2, 0, Math.PI*2);
      ctx.fill();
    }
  }
}

function drawTD() {
  if (!G.touchdown) return;
  if (G.tick % 3 === 0) return;
  ctx.drawImage(IMG.touchdown,
    W/2 - IMG.touchdown.width/2,
    H/2 - IMG.touchdown.height/2
  );
}

function drawGameOver() {
  ctx.fillStyle = 'rgba(0,0,0,0.7)';
  ctx.fillRect(0, 0, W, H);
  ctx.fillStyle = '#8f8';
  ctx.font = 'bold 28px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('GAME OVER', W/2, H/2 - 16);
  ctx.font = '16px monospace';
  ctx.fillStyle = '#fff';
  ctx.fillText('Score: ' + G.score, W/2, H/2 + 12);
  ctx.font = '12px monospace';
  ctx.fillStyle = '#888';
  ctx.fillText('Tap or press any key to play again', W/2, H/2 + 36);
  ctx.textAlign = 'left';
}

function drawHUD() {
  // Draw score using sprite numbers
  let t = G.usedTime;
  if (G.startTime > 0) t += Date.now() - G.startTime;
  let secs = Math.max(0, Math.ceil((60000 - t) / 1000));
  let tensT = Math.floor(secs / 10), onesT = secs % 10;
  let tensS = Math.floor(G.score / 10), onesS = G.score % 10;

  // Draw on canvas bottom border (outside game area - use HUD div instead)
  // (We use the HTML HUD div above)
}

function draw() {
  ctx.clearRect(0, 0, W, H);
  drawField();
  drawSprites();
  drawQB();
  drawTD();
  if (G.gameOver) drawGameOver();
}

// ---- Game Logic ----

function updateHUD() {
  document.getElementById('sc').textContent = G.score;
  const downs = ['1st','2nd','3rd','4th'];
  document.getElementById('dn').textContent = downs[Math.min(G.down-1,3)];
  document.getElementById('ytg').textContent = Math.max(G.toFirst, 0);
  let t = G.usedTime;
  if (G.startTime > 0) t += Date.now() - G.startTime;
  document.getElementById('tm').textContent = Math.max(0, Math.ceil((60000-t)/1000));
}

function setMsg(txt) { document.getElementById('msg').textContent = txt; }

function tryMove(dx, dy) {
  if (G.gameOver) { newGame(); return; }
  if (G.sacked || G.touchdown) return;
  if (G.pauseTime > 0) return;
  doMove(dx, dy);
}

function doMove(dx, dy) {
  // Start timer on first move
  if (G.startTime === 0 && !G.gameOver) {
    G.startTime = Date.now();
  }

  let nx = Math.max(0, Math.min(HCELLS-1, G.qbX + dx));
  let ny = Math.max(0, Math.min(VCELLS-1, G.qbY + dy));

  let cell = G.field[nx][ny];

  // Sack collision
  if (cell >= 8 && cell <= 12) {
    G.qbX = nx; G.qbY = ny;
    G.sacked = true;
    G.field[nx][ny] = 15; // sack marker
    G.pauseTime = Date.now() + 2000;
    setMsg('SACKED!');
    draw(); updateHUD();
    return;
  }

  // Touchdown!
  if (nx >= HCELLS - 1) {
    G.qbX = HCELLS - 1; G.qbY = ny;
    G.score += 7;
    G.touchdown = true;
    G.pauseTime = Date.now() + 3000;
    setMsg('TOUCHDOWN! +7 pts!');
    draw(); updateHUD();
    return;
  }

  // Ref bonus
  if (cell === 6 || cell === 7) {
    G.score += 2;
    G.field[nx][ny] = 0;
    setMsg('Hit the referee! +2 pts');
  }

  G.qbX = nx; G.qbY = ny;
  G.qbFrame = (G.qbFrame + 1) % 5;

  // Scroll viewport
  if (dx > 0 && G.qbX >= G.viewX + Math.floor(VIEWW * 3/4)) {
    G.viewX = Math.min(G.qbX - Math.floor(VIEWW/2), HCELLS - VIEWW);
  }
  if (dx < 0 && G.qbX <= G.viewX + Math.floor(VIEWW/4)) {
    G.viewX = Math.max(G.qbX - Math.floor(VIEWW/2), 0);
  }

  draw(); updateHUD();
}

function moveDefenders() {
  if (G.startTime === 0 || G.sacked || G.touchdown || G.gameOver) return;
  let minX = Math.max(0, G.viewX - 1);
  let maxX = Math.min(HCELLS, G.viewX + VIEWW + 1);
  for (let x = minX; x < maxX; x++) {
    for (let y = 0; y < VCELLS; y++) {
      let c = G.field[x][y];
      if (c < 8 || c > 12) continue;
      if (Math.random() > 0.35) continue;
      let tx = x, ty = y;
      // Chase QB half the time
      if (Math.random() < 0.5) {
        tx = x + (x < G.qbX ? 1 : x > G.qbX ? -1 : 0);
      } else {
        ty = y + (y < G.qbY ? 1 : y > G.qbY ? -1 : 0);
        if (Math.random() < 0.3) tx = x + (Math.random()<0.5?1:-1);
      }
      tx = Math.max(1, Math.min(HCELLS-2, tx));
      ty = Math.max(0, Math.min(VCELLS-1, ty));
      if (G.field[tx][ty] === 0) {
        G.field[tx][ty] = c;
        G.field[x][y] = 0;
        if (tx === G.qbX && ty === G.qbY) {
          G.sacked = true;
          G.pauseTime = Date.now() + 2000;
          setMsg('SACKED!');
        }
      }
    }
  }
}

function endDown() {
  let gained = G.qbX - G.scrimage;
  if (G.startTime > 0) {
    G.usedTime += Date.now() - G.startTime;
    G.startTime = 0;
  }
  if (G.touchdown) {
    G.touchdown = false;
    G.qbX = 0; G.viewX = 0; G.scrimage = 0;
    G.toFirst = 10; G.down = 1;
    G.density = Math.min(G.density * 1.1, 0.45);
    clearOldDefenders();
    spawnMore();
    G.sacked = false; G.pauseTime = 0;
    setMsg('1st & 10 — Keep going!');
    draw(); updateHUD();
    return;
  }
  if (G.usedTime >= 60000) {
    G.gameOver = true;
    G.pauseTime = 0;
    setMsg('Time's up! Score: ' + G.score);
    draw(); updateHUD(); return;
  }
  G.toFirst -= gained;
  if (G.toFirst <= 0) {
    G.down = 1; G.toFirst = 10;
  } else {
    G.down++;
  }
  if (G.down > 4 && G.toFirst > 0) {
    G.gameOver = true;
    G.pauseTime = 0;
    setMsg('Turnover on downs! Score: ' + G.score);
    draw(); updateHUD(); return;
  }
  G.scrimage = G.qbX;
  clearOldDefenders();
  spawnMore();
  G.sacked = false; G.pauseTime = 0;
  const dn = ['1st','2nd','3rd','4th'];
  setMsg(dn[Math.min(G.down-1,3)] + ' & ' + Math.max(G.toFirst,0));
  draw(); updateHUD();
}

function clearOldDefenders() {
  for (let x = 0; x <= G.qbX; x++)
    for (let y = 0; y < VCELLS; y++) {
      let c = G.field[x][y];
      if (c >= 6 && c <= 18) G.field[x][y] = 0;
    }
}

// Game loop
let lastTick = 0;
function loop(ts) {
  if (ts - lastTick > 333) {
    lastTick = ts;
    if (!G.gameOver) {
      G.tick++;
      moveDefenders();
      updateHUD();
      draw();
      if (G.pauseTime > 0 && Date.now() > G.pauseTime) {
        endDown();
      }
      let t = G.usedTime;
      if (G.startTime > 0) t += Date.now() - G.startTime;
      if (t >= 60000 && !G.sacked && !G.touchdown && !G.gameOver) endDown();
    }
  }
  requestAnimationFrame(loop);
}

function initGame() {
  newGame();
  C.addEventListener('keydown', e => {
    const map = {ArrowLeft:[-1,0], ArrowRight:[1,0], ArrowUp:[0,-1], ArrowDown:[0,1]};
    if (map[e.key]) { e.preventDefault(); tryMove(...map[e.key]); }
    else if (e.key === ' ' || e.key === 'Enter') { if(G.gameOver) newGame(); }
  });
  C.addEventListener('click', () => { if(G.gameOver) newGame(); C.focus(); });
  C.focus();
  requestAnimationFrame(loop);
}
</script>
</body>
</html>